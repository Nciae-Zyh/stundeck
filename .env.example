# StunDeck intentionally ships without credentials.
STUNDECK_LISTEN=127.0.0.1:8080
STUNDECK_DATA_DIR=./data
# These default to files inside STUNDECK_DATA_DIR. Override them only when
# the runtime platform maps database and secret storage separately.
# STUNDECK_DATABASE=./data/stundeck.db
# STUNDECK_MASTER_KEY_FILE=./data/master.key
STUNDECK_NATMAP_BINARY=natmap
STUNDECK_NOTIFY_BINARY=stundeck-notify
STUNDECK_STUN_SERVER=turn.cloudflare.com:3478
STUNDECK_KEEPALIVE_SERVER=www.cloudflare.com:80
STUNDECK_SECURE_COOKIES=false

# Optional. Prefer a Docker secret or a root-readable file in production.
# STUNDECK_MASTER_KEY_FILE=/run/secrets/stundeck_master_key

# Cloudflare Tunnel connector (bundled in Docker / fnOS images)
STUNDECK_CLOUDFLARED_BINARY=cloudflared
